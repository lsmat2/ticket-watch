# SeatGeek: free client id from https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# StubHub: request API access at https://developer.stubhub.com (not self-serve).
# Leave blank until you have credentials; the provider turns on automatically when both are set.
STUBHUB_CLIENT_ID=
STUBHUB_CLIENT_SECRET=
STUBHUB_SANDBOX=false

# ntfy: pick a long random topic, then subscribe to it in the ntfy iOS/Android app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

POLL_MINUTES=10
